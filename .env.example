# ---------------------------------------------------------------------------
# StudyQuest API — environment template (Render: set these as Environment Vars)
# Copy to `.env` for local development. NEVER commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Render provides PORT; keep 8080 locally.
PORT=8080
NODE_ENV=development
# Comma-separated browser origins allowed to call this API (the Vercel app).
CORS_ORIGINS=http://localhost:3000

# --- Supabase (server only — never expose these to the browser) -------------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Anon key: used to verify learner access tokens.
SUPABASE_ANON_KEY=
# Secret / service-role key: bypasses Row Level Security. Used for admin reads
# and demo seeding only. Keep this value out of the frontend entirely.
SUPABASE_SECRET_KEY=

# --- Demo mode -------------------------------------------------------------
# true  -> serve bundled sample content from memory (no Supabase needed).
# false -> only matters once Supabase is connected; the data layer below is
#          required then.
# Demo *accounts* and `demo.<userId>` bearer tokens are refused whenever
# SUPABASE_URL is set, regardless of this flag.
ENABLE_DEMO_MODE=true
# Optional: when set, POST /api/auth/demo-session must send `{ "password": ... }`.
DEMO_PASSWORD=
